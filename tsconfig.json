{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "isolatedModules": true,
    "strict": false,
    "target": "ES2020",
    "module": "NodeNext",
    "noImplicitAny": true,
    "outDir": "lib",
    "rootDir": "./src",
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "moduleResolution": "NodeNext"
  }
}
